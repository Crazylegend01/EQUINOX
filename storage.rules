rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Users can only upload to their own directory
    match /uploads/{userId}/{chatId}/{fileId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null &&
                     request.auth.uid == userId &&
                     request.resource.size < 10 * 1024 * 1024 && // 10 MB limit
                     (request.resource.contentType.matches('image/.*') ||
                      request.resource.contentType == 'application/pdf' ||
                      request.resource.contentType == 'text/plain' ||
                      request.resource.contentType.matches('application/vnd.*'));
    }
  }
}
